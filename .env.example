# Server Configuration
PORT=3000
NODE_ENV=development

# Application Settings
APP_NAME=Zero-Code Automation IDE
BASE_URL=http://localhost:3000

# Security Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# Browser Settings
DEFAULT_BROWSER=chromium
MAX_SESSIONS=5
SESSION_TIMEOUT=1800000

# File Storage
EXPORT_DIR=sample-export
MAX_FILE_SIZE=10mb

# Logging
LOG_LEVEL=info

# Development Settings
ENABLE_SWAGGER=false
ENABLE_DEBUG_LOGGING=true

# Local AI (optional — Ollama for locator-healing fallback)
# Leave empty to auto-detect. Set to 'null' to force-disable.
ZAC_AI_PROVIDER=
ZAC_AI_MODEL=mistral
ZAC_AI_BASE_URL=http://127.0.0.1:11434

# Email / SMTP (optional — used by /api/email/* and the dashboard's
# "Email report" button). The Settings UI writes these to
# config/email.json at runtime; values here are the bootstrap fallback
# (e.g. for headless CI). Never commit a real SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

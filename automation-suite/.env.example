# ZeroAutomationCode - automation-suite/.env.example
# Copy to .env and adjust per environment.

# ---- Target under test ----
ZAC_ENV=dev                      # dev | qa | staging | prod
ZAC_UI_BASE_URL=http://localhost:3000
ZAC_API_BASE_URL=http://localhost:3000/api

# ---- Browser / UI ----
ZAC_BROWSER=chromium             # chromium | firefox | webkit
ZAC_HEADLESS=true
ZAC_DEFAULT_TIMEOUT_MS=15000
ZAC_NAV_TIMEOUT_MS=30000

# ---- Auth (none for ZAC core; placeholders kept for parity) ----
ZAC_AUTH_MODE=none               # none | bearer | api_key | basic
ZAC_API_KEY=
ZAC_BEARER_TOKEN=

# ---- Self-healer ----
ZAC_HEALER_ENABLED=true
ZAC_HEALER_REPORT_DIR=reports/healer

# ---- Reporting ----
ALLURE_RESULTS_DIR=reports/allure-results

# ---- Performance (k6) ----
K6_VUS=50
K6_DURATION=1m
K6_P95_THRESHOLD_MS=500
